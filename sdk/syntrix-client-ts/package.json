{
  "name": "@syntrix/client",
  "version": "0.1.0",
  "description": "TypeScript client for Syntrix",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --noEmit && tsc -p tsconfig.tools.json && bun scripts/build.ts",
    "test": "bun test",
    "coverage": "bun test --coverage",
    "test:package": "bun scripts/test-package.ts"
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "@types/node": "^25.0.3",
    "typescript": "^5.0.0",
    "rxdb": "17.5.0",
    "rxjs": "7.8.2",
    "fake-indexeddb": "6.2.5"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "patchedDependencies": {
      "rxdb@17.5.0": "patches/rxdb@17.5.0.patch"
    }
  },
  "files": [
    "dist",
    "README.md"
  ]
}
